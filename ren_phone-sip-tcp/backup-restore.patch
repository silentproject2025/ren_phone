@@ -0,0 +1,111 @@
+#!/usr/bin/env python3
+# apply_backup_patch.py -- memasang fitur BACKUP & RESTORE pengaturan ke phone.ino
+#
+# Jalankan dari folder repo (yang berisi phone.ino, backup_renphone.ino, backup_core.h):
+#     python3 apply_backup_patch.py
+#
+# Yang diubah:
+#   phone.ino                         enum Screen, apps[] (disembunyikan dari Home), ikon app,
+#                                     daftar layar "edge-back" & kategori Sistem, baris di Pengaturan
+#   .github/workflows/build-firmware.yml   menyalin backup_renphone.ino + backup_core.h ke build_sketch/
+# Aman dijalankan ulang (kalau sudah terpasang, dilewati). Kalau ada patokan yang tidak ketemu,
+# TIDAK ada file yang diubah sama sekali.
+import sys, os
+
+for need in ('phone.ino', 'backup_renphone.ino', 'backup_core.h'):
+    if not os.path.exists(need):
+        print("ERROR: %s tidak ada di folder ini" % need); sys.exit(1)
+
+s = open('phone.ino', encoding='utf-8').read()
+if 'SCR_BACKUP' in s:
+    print("Backup & Restore sudah terpasang, dilewati"); sys.exit(0)
+
+def rep(src, old, new, what):
+    n = src.count(old)
+    if n != 1:
+        print("ERROR: patokan '%s' ketemu %d kali (harus 1). Tidak ada yang diubah." % (what, n)); sys.exit(1)
+    return src.replace(old, new)
+
+# 1) enum Screen
+s = rep(s, "              SCR_EBOOK };\nenum Orientation",
+        "              SCR_EBOOK,\n              // Backup & Restore pengaturan -- lihat backup_renphone.ino + backup_core.h\n              SCR_BACKUP };\nenum Orientation",
+        "enum Screen")
+
+# 2) deklarasi maju (sebelum tabel apps[])
+s = rep(s, "void aboutLoopPoll();\n",
+        "void aboutLoopPoll();\n// ---- backup_renphone.ino: Backup & Restore pengaturan ----\nvoid backupEnter(); void backupExit(); void drawBackup(LGFX_Sprite&); void backupTouch(int,int,bool,bool);\n",
+        "forward decl")
+
+# 3) tabel apps[] + jumlah
+s = rep(s, "AppDef apps[43] = {", "AppDef apps[44] = {", "apps[43]")
+s = rep(s, '  { "Buku",    \'b\', 0, ebookEnter,  ebookExit,  drawEbook,  ebookTouch,  SCR_EBOOK  },\n};\n#define APP_COUNT 43',
+        '  { "Buku",    \'b\', 0, ebookEnter,  ebookExit,  drawEbook,  ebookTouch,  SCR_EBOOK  },\n'
+        '  // ---- Backup & Restore: simpan/pulihkan pengaturan ke SD (disembunyikan dari grid Home; ada di Pengaturan) ----\n'
+        '  { "Backup",  \'z\', 0x357C, backupEnter, backupExit, drawBackup, backupTouch, SCR_BACKUP },\n};\n#define APP_COUNT 44',
+        "apps entry + APP_COUNT")
+
+# 4) disembunyikan dari grid Home secara default (seperti Atur Home)
+s = rep(s, "homeHide[i]=(apps[i].screen==SCR_HOMEEDIT); }",
+        "homeHide[i]=(apps[i].screen==SCR_HOMEEDIT || apps[i].screen==SCR_BACKUP); }", "homeLayoutDefault")
+
+# 5) ikon app (dipakai di App Switcher dsb.)
+s = rep(s, "    case 'i': { // About Phone\n",
+        "    case 'z': { // Backup: panah turun ke baki\n"
+        "      int rr=max(8,r-6);\n"
+        "      s.fillRect(cx-max(1,rr/9),cy-rr*2/3,max(2,rr/4),rr*2/3,ic);\n"
+        "      s.fillTriangle(cx-rr/2,cy,cx+rr/2,cy,cx,cy+rr/2,ic);\n"
+        "      s.fillRect(cx-rr*2/3,cy+rr*2/3,rr*4/3,max(2,rr/6),ic);\n"
+        "      break;\n"
+        "    }\n"
+        "    case 'i': { // About Phone\n", "drawAppIcon")
+
+# 6) swipe-back dari tepi + kategori Sistem
+s = rep(s, "case SCR_NASAIMG: case SCR_ABOUT: case SCR_OWNER: case SCR_HOMEEDIT: case SCR_REMOTE:\n    case SCR_CHAT:",
+        "case SCR_NASAIMG: case SCR_ABOUT: case SCR_OWNER: case SCR_HOMEEDIT: case SCR_REMOTE: case SCR_BACKUP:\n    case SCR_CHAT:",
+        "screenHasEdgeBack")
+s = rep(s, "    case SCR_MICLEVEL: case SCR_ABOUT: case SCR_OWNER: case SCR_HOMEEDIT: case SCR_REMOTE:\n      return 5;",
+        "    case SCR_MICLEVEL: case SCR_ABOUT: case SCR_OWNER: case SCR_HOMEEDIT: case SCR_REMOTE: case SCR_BACKUP:\n      return 5;",
+        "homeCatOfScreen")
+
+# 7) Pengaturan: baris "Backup & Restore" di bagian TENTANG
+s = rep(s, "SR_ABOUT, SR_POWER, SR_HOMEEDIT };", "SR_ABOUT, SR_POWER, SR_HOMEEDIT, SR_BACKUP };", "enum SR")
+s = rep(s, "  settAddRow(SR_ABOUT,g,34,0,nullptr,y); g++;\n",
+        "  settAddRow(SR_ABOUT,g,34,0,nullptr,y);\n  settAddRow(SR_BACKUP,g,34,0,nullptr,y); g++;\n", "settBuildLayout")
+s = rep(s, "case SR_TCAL: case SR_ABOUT: case SR_POWER:\n      return true;",
+        "case SR_TCAL: case SR_ABOUT: case SR_POWER: case SR_BACKUP:\n      return true;", "settHasChip")
+s = rep(s, "    case SR_ABOUT:    col=CHIP_GRAY;   break;\n",
+        "    case SR_ABOUT:    col=CHIP_GRAY;   break;\n    case SR_BACKUP:   col=CHIP_TEAL;   break;\n", "settChip warna")
+s = rep(s, "    case SR_ABOUT:     // \"i\"\n",
+        "    case SR_BACKUP:    // panah turun ke baki\n"
+        "      s.fillRect(cx-1,cy-8,3,8,W); s.fillTriangle(cx-5,cy-1,cx+5,cy-1,cx,cy+5,W);\n"
+        "      s.fillRect(cx-7,cy+7,15,2,W);\n"
+        "      break;\n"
+        "    case SR_ABOUT:     // \"i\"\n", "settChip glyph")
+s = rep(s, "      case SR_ABOUT:\n        s.setTextColor(T().text); s.setCursor(xl,ty); s.print(\"About Phone\");",
+        "      case SR_BACKUP:\n        s.setTextColor(T().text); s.setCursor(xl,ty); s.print(\"Backup & Restore\");\n"
+        "        settChevron(s,xr-4,ty+4,T().subtext);\n        break;\n"
+        "      case SR_ABOUT:\n        s.setTextColor(T().text); s.setCursor(xl,ty); s.print(\"About Phone\");", "draw SR_ABOUT")
+s = rep(s, "    case SR_ABOUT:\n      navPush(SCR_ABOUT); break;",
+        "    case SR_ABOUT:\n      navPush(SCR_ABOUT); break;\n    case SR_BACKUP:\n      navPush(SCR_BACKUP); break;", "touch SR_ABOUT")
+
+# 8) workflow GitHub Actions
+wf = '.github/workflows/build-firmware.yml'
+w = None
+if os.path.exists(wf):
+    w = open(wf, encoding='utf-8').read()
+    if 'backup_renphone.ino' in w:
+        w = None
+    else:
+        a = "          cp gutenberg_renphone.ino build_sketch/\n"
+        if w.count(a) == 1:
+            w = w.replace(a, a + "          cp backup_renphone.ino build_sketch/\n          cp backup_core.h build_sketch/\n")
+        else:
+            print("PERINGATAN: tambahkan 'cp backup_renphone.ino build_sketch/' dan 'cp backup_core.h build_sketch/' ke workflow sendiri")
+            w = None
+else:
+    print("PERINGATAN: workflow tidak ditemukan; salin backup_renphone.ino + backup_core.h ke sketch sendiri")
+
+open('phone.ino', 'w', encoding='utf-8').write(s)
+if w:
+    open(wf, 'w', encoding='utf-8').write(w)
+print("OK: Backup & Restore terpasang (Pengaturan > TENTANG > Backup & Restore)")
diff --git a/backup_core.h b/backup_core.h
new file mode 100644
index 0000000..054821d
--- /dev/null
+++ b/backup_core.h
@@ -0,0 +1,163 @@
+// backup_core.h -- logika inti Backup & Restore pengaturan NyxOS.
+// SENGAJA tanpa dependensi Arduino / ESP-IDF (hanya <stdint.h>, <string.h>, <stdio.h>) supaya bisa
+// diuji di komputer: lihat tests_backup/. Penghubung ke NVS, kartu SD, dan layar ada di
+// backup_renphone.ino.
+//
+// FORMAT FILE (.nbk, little-endian):
+//   header  14 byte : "NYXB1\0" (6) | flags u8 | versi u8 | epoch u32 | jumlah rekaman u16
+//   rekaman (berulang)  : nsLen u8 | ns | keyLen u8 | key | tipe u8 | panjang u32 | data
+//   penutup          : 1 byte 0 (nsLen = 0)
+//   CRC32 (u32)      : atas semua byte dari akhir header sampai penutup (termasuk penutup)
+// flags bit0 = file ini MENGANDUNG sandi / API key.
+//
+// KEAMANAN SAAT RESTORE: file dari SD dianggap tidak tepercaya -> CRC dicek penuh, semua panjang
+// dicek terhadap batas buffer, dan namespace sistem (nvs*, phy*, bt*, otaguard) tidak pernah ditulis.
+#pragma once
+#include <stdint.h>
+#include <string.h>
+#include <stdio.h>
+
+#define BK_HDR        14
+#define BK_VERSION    1
+#define BK_FLAG_SECRETS 0x01
+#define BK_NAME_MAX   15          // batas NVS: namespace & key maksimum 15 karakter
+
+// tipe nilai (kode sendiri, bukan nvs_type_t, supaya core tidak butuh nvs.h)
+enum { BK_T_U8 = 1, BK_T_I8, BK_T_U16, BK_T_I16, BK_T_U32, BK_T_I32, BK_T_U64, BK_T_I64, BK_T_STR, BK_T_BLOB };
+
+static inline int bkScalarSize(uint8_t t) {
+  switch (t) {
+    case BK_T_U8: case BK_T_I8: return 1;
+    case BK_T_U16: case BK_T_I16: return 2;
+    case BK_T_U32: case BK_T_I32: return 4;
+    case BK_T_U64: case BK_T_I64: return 8;
+  }
+  return 0;   // STR / BLOB / tak dikenal
+}
+
+// ---------------------------------------------------------------- CRC32 (zlib), bisa bertahap
+static inline uint32_t bkCrc32(uint32_t crc, const uint8_t* d, size_t n) {
+  crc = ~crc;
+  while (n--) {
+    crc ^= *d++;
+    for (int k = 0; k < 8; k++) crc = (crc >> 1) ^ (0xEDB88320u & (uint32_t)(-(int32_t)(crc & 1u)));
+  }
+  return ~crc;
+}
+
+// ---------------------------------------------------------------- kebijakan: apa yang di-backup
+// Namespace milik sistem / ESP-IDF / pengaman OTA: TIDAK pernah di-backup dan TIDAK pernah ditulis balik.
+static inline bool bkNsSkip(const char* ns) {
+  if (!strncmp(ns, "nvs", 3) || !strncmp(ns, "phy", 3) || !strncmp(ns, "bt", 2)) return true;
+  if (!strcmp(ns, "otaguard")) return true;      // status rollback OTA: bukan pengaturan pengguna
+  return false;
+}
+// Sandi / API key: ikut hanya kalau pengguna memilih "Sertakan sandi & API key".
+static inline bool bkIsSecret(const char* ns, const char* key) {
+  if (!strcmp(ns, "wifi") || !strcmp(ns, "sip") || !strcmp(ns, "chat") || !strcmp(ns, "gemini")) return true;
+  if (!strcmp(ns, "rcfg") && !strncmp(key, "pass", 4)) return true;   // sandi AP Remote Control
+  return false;
+}
+
+// ---------------------------------------------------------------- penulis (ke buffer memori)
+struct BkWriter {
+  uint8_t* buf; size_t cap, len;
+  uint32_t count;      // jumlah rekaman
+  bool     over;       // buffer kepenuhan
+};
+
+static inline void bkBegin(BkWriter& w, uint8_t* buf, size_t cap) {
+  w.buf = buf; w.cap = cap; w.len = BK_HDR; w.count = 0; w.over = (cap < BK_HDR + 8);
+}
+static inline void bkPut(BkWriter& w, const void* p, size_t n) {
+  if (w.over) return;
+  if (w.len + n > w.cap) { w.over = true; return; }
+  memcpy(w.buf + w.len, p, n); w.len += n;
+}
+static inline void bkPutU32(BkWriter& w, uint32_t v) {
+  uint8_t b[4] = { (uint8_t)v, (uint8_t)(v >> 8), (uint8_t)(v >> 16), (uint8_t)(v >> 24) };
+  bkPut(w, b, 4);
+}
+// Tambah satu rekaman. false = argumen tidak valid (nama kosong / terlalu panjang / tipe salah).
+static inline bool bkAddRecord(BkWriter& w, const char* ns, const char* key, uint8_t type, const void* data, uint32_t len) {
+  size_t nl = strlen(ns), kl = strlen(key);
+  if (nl == 0 || nl > BK_NAME_MAX || kl == 0 || kl > BK_NAME_MAX) return false;
+  if (type < BK_T_U8 || type > BK_T_BLOB) return false;
+  int ss = bkScalarSize(type);
+  if (ss && (uint32_t)ss != len) return false;
+  if (!ss && type == BK_T_STR && len == 0) return false;     // string NVS selalu >= 1 byte (NUL)
+  uint8_t b;
+  b = (uint8_t)nl; bkPut(w, &b, 1); bkPut(w, ns, nl);
+  b = (uint8_t)kl; bkPut(w, &b, 1); bkPut(w, key, kl);
+  bkPut(w, &type, 1); bkPutU32(w, len); bkPut(w, data, len);
+  if (!w.over) w.count++;
+  return !w.over;
+}
+// Selesai: tulis penutup + CRC, isi header. Mengembalikan panjang total file, atau 0 kalau gagal.
+static inline size_t bkFinish(BkWriter& w, uint8_t flags, uint32_t epoch) {
+  uint8_t z = 0; bkPut(w, &z, 1);
+  if (w.over || w.count > 0xFFFF) return 0;
+  uint32_t crc = bkCrc32(0, w.buf + BK_HDR, w.len - BK_HDR);
+  bkPutU32(w, crc);
+  if (w.over) return 0;
+  memcpy(w.buf, "NYXB1\0", 6);
+  w.buf[6] = flags; w.buf[7] = BK_VERSION;
+  w.buf[8] = (uint8_t)epoch; w.buf[9] = (uint8_t)(epoch >> 8); w.buf[10] = (uint8_t)(epoch >> 16); w.buf[11] = (uint8_t)(epoch >> 24);
+  w.buf[12] = (uint8_t)w.count; w.buf[13] = (uint8_t)(w.count >> 8);
+  return w.len;
+}
+
+// ---------------------------------------------------------------- pembaca
+struct BkHdr { uint8_t flags; uint8_t ver; uint32_t epoch; uint16_t count; };
+
+// Baca 14 byte header saja (dipakai untuk daftar riwayat). false = bukan file backup NyxOS.
+static inline bool bkParseHdr(const uint8_t* b, size_t n, BkHdr& h) {
+  if (n < BK_HDR || memcmp(b, "NYXB1\0", 6) != 0) return false;
+  h.flags = b[6]; h.ver = b[7];
+  h.epoch = (uint32_t)b[8] | ((uint32_t)b[9] << 8) | ((uint32_t)b[10] << 16) | ((uint32_t)b[11] << 24);
+  h.count = (uint16_t)(b[12] | (b[13] << 8));
+  return h.ver == BK_VERSION;
+}
+// Periksa file utuh: header + CRC. true = aman dibaca rekamannya.
+static inline bool bkVerify(const uint8_t* b, size_t n, BkHdr& h) {
+  if (n < BK_HDR + 1 + 4 || !bkParseHdr(b, n, h)) return false;
+  uint32_t want = (uint32_t)b[n - 4] | ((uint32_t)b[n - 3] << 8) | ((uint32_t)b[n - 2] << 16) | ((uint32_t)b[n - 1] << 24);
+  return bkCrc32(0, b + BK_HDR, n - BK_HDR - 4) == want;
+}
+
+struct BkRec { char ns[BK_NAME_MAX + 1]; char key[BK_NAME_MAX + 1]; uint8_t type; uint32_t len; const uint8_t* data; };
+
+// Rekaman berikutnya. pos = indeks byte (mulai BK_HDR), end = n - 4 (sebelum CRC).
+// 1 = ada rekaman, 0 = selesai (penutup), -1 = data rusak.
+static inline int bkNext(const uint8_t* b, size_t end, size_t& pos, BkRec& r) {
+  if (pos >= end) return -1;
+  size_t nl = b[pos++];
+  if (nl == 0) return 0;
+  if (nl > BK_NAME_MAX || pos + nl + 1 > end) return -1;
+  memcpy(r.ns, b + pos, nl); r.ns[nl] = 0; pos += nl;
+  size_t kl = b[pos++];
+  if (kl == 0 || kl > BK_NAME_MAX || pos + kl + 1 + 4 > end) return -1;
+  memcpy(r.key, b + pos, kl); r.key[kl] = 0; pos += kl;
+  r.type = b[pos++];
+  r.len = (uint32_t)b[pos] | ((uint32_t)b[pos + 1] << 8) | ((uint32_t)b[pos + 2] << 16) | ((uint32_t)b[pos + 3] << 24);
+  pos += 4;
+  if (r.type < BK_T_U8 || r.type > BK_T_BLOB) return -1;
+  int ss = bkScalarSize(r.type);
+  if (ss && r.len != (uint32_t)ss) return -1;
+  if (r.len > end - pos) return -1;
+  if (r.type == BK_T_STR && (r.len == 0 || b[pos + r.len - 1] != 0)) return -1;   // string harus ber-NUL
+  r.data = b + pos; pos += r.len;
+  return 1;
+}
+
+// ---------------------------------------------------------------- nama file di kartu SD
+// "nyx_007.nbk" -> 7 ; selain itu -1. (nama boleh berawalan path)
+static inline int bkParseName(const char* name) {
+  const char* s = strrchr(name, '/'); s = s ? s + 1 : name;
+  if (strncmp(s, "nyx_", 4) != 0) return -1;
+  int n = 0, d = 0; const char* p = s + 4;
+  while (*p >= '0' && *p <= '9' && d < 4) { n = n * 10 + (*p - '0'); p++; d++; }
+  if (d == 0 || strcmp(p, ".nbk") != 0) return -1;
+  return n;
+}
+static inline void bkMakeName(char* out, size_t cap, int num) { snprintf(out, cap, "/backup/nyx_%03d.nbk", num); }
diff --git a/backup_renphone.ino b/backup_renphone.ino
new file mode 100644
index 0000000..f8cf744
--- /dev/null
+++ b/backup_renphone.ino
@@ -0,0 +1,528 @@
+// =====================================================================
+// backup_renphone.ino -- BACKUP & RESTORE PENGATURAN (SCR_BACKUP) untuk Accretion Phone / NyxOS
+// =====================================================================
+// Fungsi:
+//   * "Buat Backup" : seluruh pengaturan di NVS (tema, kecerahan, susunan Home, kalibrasi, kamus
+//                     pelajaran, Remote Control, dst.) disimpan ke SD: /backup/nyx_NNN.nbk
+//   * "Pulihkan"    : tulis balik isi file ke NVS lalu HP restart sendiri (nilai pengaturan
+//                     dibaca ke RAM saat boot, jadi restart perlu supaya semuanya terpakai)
+//   * "Hapus"       : buang satu file backup
+//   * Sakelar "Sertakan sandi & API key" (default MATI): sandi WiFi, akun SIP, akun Chat, API key
+//     Gemini, dan sandi AP Remote Control hanya ikut kalau sakelar ini nyala. File di SD
+//     TIDAK dienkripsi, jadi default-nya tidak menyertakan rahasia.
+//
+// CARA KERJA: NVS tidak punya "daftar semua pengaturan", jadi kita menyisir seluruh partisi NVS
+// lewat nvs_entry_find(). Artinya pengaturan dari fitur BARU otomatis ikut ter-backup tanpa
+// perlu mengubah file ini. Namespace sistem (nvs*, phy*, bt*, otaguard) dikecualikan.
+// Format file & pemeriksaan keamanan ada di backup_core.h (diuji di komputer: tests_backup/).
+//
+// CATATAN: Restore MENIMPA nilai yang ada di file backup. Pengaturan yang dibuat SETELAH backup
+// (tidak ada di file) tidak dihapus. Maksimum 6 backup tersimpan; yang paling lama otomatis dibuang
+// saat membuat backup baru.
+//
+// ATURAN PROYEK YANG DIIKUTI:
+//   - Tidak ada String dibuat tiap frame; semua teks lewat buffer char di stack/statis.
+//   - Buffer besar (hingga 96 KB) dialokasi di PSRAM hanya selama operasi, lalu dibebaskan.
+//     RAM internal tidak tersentuh.
+//   - Fungsi publik hanya memakai tipe primitif / LGFX_Sprite& (aman dari bug prototype arduino-cli).
+//   - Layout dihitung dari SCR_W/SCR_H (potret & lanskap); hit-test memakai rect yang sama dgn gambar.
+//
+// DIPASANG ke phone.ino lewat apply_backup_patch.py:
+//   enum Screen      <- SCR_BACKUP
+//   apps[] + warna   <- { "Backup", 'z', ... }  (disembunyikan dari grid Home, ada di Pengaturan)
+//   drawAppIcon()    <- case 'z'
+//   Pengaturan       <- baris "Backup & Restore" (bagian TENTANG)
+// =====================================================================
+#include <nvs.h>
+#include <nvs_flash.h>
+#include "esp_idf_version.h"
+#include "backup_core.h"
+
+#define BK_DIR        "/backup"
+#define BK_KEEP       6                 // jumlah file backup yang disimpan di SD
+#define BK_BUF_MAX    (96 * 1024)       // batas ukuran satu file backup
+#define BK_VALUE_MAX  (32 * 1024)       // nilai NVS lebih besar dari ini dilewati
+#define BK_ROW_H      36
+#define BK_NVS_NS     "nyxbak"
+
+enum { BKR_CREATE = 0, BKR_TOGGLE, BKR_LIST, BKR_RESTORE, BKR_DELETE, BKR_N };
+
+static bool          bkSecrets   = false;
+static int           bkListN     = 0;
+static int           bkNum[BK_KEEP];
+static uint32_t      bkEpoch[BK_KEEP];
+static uint32_t      bkSize[BK_KEEP];
+static uint16_t      bkCnt[BK_KEEP];
+static uint8_t       bkFlg[BK_KEEP];
+static bool          bkValid[BK_KEEP];
+static int           bkSel       = -1;
+static float         bkScroll    = 0;
+static int           bkR[BKR_N][4];
+static int           bkArmKind   = 0;          // 0 tidak ada | 1 menunggu konfirmasi Pulihkan | 2 ... Hapus
+static unsigned long bkArmUntil  = 0;
+static unsigned long bkRestartAt = 0;          // != 0 -> restart saat waktunya (diurus drawBackup)
+static char          bkMsg[44]   = "";
+static bool          bkDown = false, bkMoved = false, bkDragList = false;
+static int           bkPx = 0, bkPy = 0, bkLy = 0;
+static nvs_iterator_t bkIt = NULL;
+
+static void bkSay(const char* m, int ms) {
+  strncpy(bkMsg, m, sizeof(bkMsg) - 1); bkMsg[sizeof(bkMsg) - 1] = 0;
+  showToast(bkMsg, ms);                       // toast diam kalau mode Jangan Ganggu aktif -> teks tetap tampil di layar
+  needRedraw = true;
+}
+
+// ---------------------------------------------------------------------
+// iterasi NVS (API berubah antara ESP-IDF 4.x dan 5.x)
+// ---------------------------------------------------------------------
+static bool bkItFirst() {
+#if ESP_IDF_VERSION_MAJOR >= 5
+  bkIt = NULL;
+  return nvs_entry_find(NVS_DEFAULT_PART_NAME, NULL, NVS_TYPE_ANY, &bkIt) == ESP_OK && bkIt != NULL;
+#else
+  bkIt = nvs_entry_find(NVS_DEFAULT_PART_NAME, NULL, NVS_TYPE_ANY);
+  return bkIt != NULL;
+#endif
+}
+static bool bkItNext() {
+#if ESP_IDF_VERSION_MAJOR >= 5
+  return nvs_entry_next(&bkIt) == ESP_OK && bkIt != NULL;
+#else
+  bkIt = nvs_entry_next(bkIt);
+  return bkIt != NULL;
+#endif
+}
+static void bkItEnd() { if (bkIt) nvs_release_iterator(bkIt); bkIt = NULL; }
+
+static uint8_t bkTypeOf(int t) {
+  switch (t) {
+    case NVS_TYPE_U8:   return BK_T_U8;   case NVS_TYPE_I8:  return BK_T_I8;
+    case NVS_TYPE_U16:  return BK_T_U16;  case NVS_TYPE_I16: return BK_T_I16;
+    case NVS_TYPE_U32:  return BK_T_U32;  case NVS_TYPE_I32: return BK_T_I32;
+    case NVS_TYPE_U64:  return BK_T_U64;  case NVS_TYPE_I64: return BK_T_I64;
+    case NVS_TYPE_STR:  return BK_T_STR;  case NVS_TYPE_BLOB: return BK_T_BLOB;
+  }
+  return 0;
+}
+
+static uint8_t* bkAlloc(size_t n) { return (uint8_t*)heap_caps_malloc(n, MALLOC_CAP_SPIRAM | MALLOC_CAP_8BIT); }
+
+// Baca satu nilai NVS -> tambahkan ke penulis. 1 = ok, 0 = dilewati, -1 = buffer penuh.
+// (nilai skalar ditulis apa adanya dalam byte-order native; ESP32 little-endian = format file)
+static int bkReadOne(void* wv, uint32_t h, const char* ns, const char* key, uint8_t t) {
+  BkWriter& w = *(BkWriter*)wv;
+  uint8_t sc[8]; const void* dp = sc; uint32_t dl = 0; bool got = false; uint8_t* tmp = NULL;
+  switch (t) {
+    case BK_T_U8:  { uint8_t  v; got = nvs_get_u8 (h, key, &v) == ESP_OK; memcpy(sc, &v, 1); dl = 1; } break;
+    case BK_T_I8:  { int8_t   v; got = nvs_get_i8 (h, key, &v) == ESP_OK; memcpy(sc, &v, 1); dl = 1; } break;
+    case BK_T_U16: { uint16_t v; got = nvs_get_u16(h, key, &v) == ESP_OK; memcpy(sc, &v, 2); dl = 2; } break;
+    case BK_T_I16: { int16_t  v; got = nvs_get_i16(h, key, &v) == ESP_OK; memcpy(sc, &v, 2); dl = 2; } break;
+    case BK_T_U32: { uint32_t v; got = nvs_get_u32(h, key, &v) == ESP_OK; memcpy(sc, &v, 4); dl = 4; } break;
+    case BK_T_I32: { int32_t  v; got = nvs_get_i32(h, key, &v) == ESP_OK; memcpy(sc, &v, 4); dl = 4; } break;
+    case BK_T_U64: { uint64_t v; got = nvs_get_u64(h, key, &v) == ESP_OK; memcpy(sc, &v, 8); dl = 8; } break;
+    case BK_T_I64: { int64_t  v; got = nvs_get_i64(h, key, &v) == ESP_OK; memcpy(sc, &v, 8); dl = 8; } break;
+    case BK_T_STR: {
+      size_t L = 0;
+      if (nvs_get_str(h, key, NULL, &L) == ESP_OK && L > 0 && L <= BK_VALUE_MAX) {
+        tmp = bkAlloc(L);
+        if (tmp) { got = nvs_get_str(h, key, (char*)tmp, &L) == ESP_OK; dp = tmp; dl = (uint32_t)L; }
+      }
+    } break;
+    case BK_T_BLOB: {
+      size_t L = 0;
+      if (nvs_get_blob(h, key, NULL, &L) == ESP_OK && L <= BK_VALUE_MAX) {
+        if (L == 0) { dp = sc; dl = 0; got = true; }
+        else { tmp = bkAlloc(L); if (tmp) { got = nvs_get_blob(h, key, tmp, &L) == ESP_OK; dp = tmp; dl = (uint32_t)L; } }
+      }
+    } break;
+  }
+  int res = 0;
+  if (got) res = bkAddRecord(w, ns, key, t, dp, dl) ? 1 : (w.over ? -1 : 0);
+  if (tmp) free(tmp);
+  return res;
+}
+
+// Kumpulkan seluruh pengaturan ke buf. 0 = ok (outLen & outN terisi), 1 = buffer kurang, 2 = NVS gagal dibaca.
+static int bkCollect(uint8_t* buf, size_t cap, bool secrets, size_t* outLen, int* outN) {
+  BkWriter w; bkBegin(w, buf, cap);
+  nvs_handle_t h = 0; bool open = false; char curNs[BK_NAME_MAX + 1] = "";
+  int status = 0;
+  bool more = bkItFirst();
+  while (more) {
+    nvs_entry_info_t info; nvs_entry_info(bkIt, &info);
+    uint8_t t = bkTypeOf((int)info.type);
+    if (t && !bkNsSkip(info.namespace_name) && (secrets || !bkIsSecret(info.namespace_name, info.key))) {
+      if (!open || strcmp(curNs, info.namespace_name) != 0) {
+        if (open) nvs_close(h);
+        open = nvs_open(info.namespace_name, NVS_READONLY, &h) == ESP_OK;
+        strncpy(curNs, info.namespace_name, BK_NAME_MAX); curNs[BK_NAME_MAX] = 0;
+      }
+      if (open) {
+        int r = bkReadOne(&w, (uint32_t)h, info.namespace_name, info.key, t);
+        if (r < 0) { status = 1; break; }
+      }
+    }
+    more = bkItNext();
+  }
+  if (open) nvs_close(h);
+  bkItEnd();
+  if (status) return status;
+  uint32_t ep = ntpSynced ? (uint32_t)time(nullptr) : 0;
+  size_t n = bkFinish(w, secrets ? BK_FLAG_SECRETS : 0, ep);
+  if (n == 0) return w.over ? 1 : 2;
+  *outLen = n; *outN = (int)w.count;
+  return 0;
+}
+
+// Tulis balik file backup (sudah diverifikasi CRC-nya) ke NVS. Mengembalikan jumlah nilai yang
+// berhasil ditulis, atau -1 kalau file ditolak.
+static int bkApply(const uint8_t* b, size_t n, int* outFail) {
+  BkHdr hd; if (!bkVerify(b, n, hd)) return -1;
+  size_t pos = BK_HDR, end = n - 4; BkRec r;
+  for (;;) {                                                        // pra-pemeriksaan: semua rekaman harus terbaca, baru mulai menulis
+    int q = bkNext(b, end, pos, r);
+    if (q < 0) return -1;                                           // file janggal -> tidak ada satu pun nilai yang ditulis
+    if (q == 0) break;
+  }
+  pos = BK_HDR;
+  nvs_handle_t h = 0; bool open = false; char curNs[BK_NAME_MAX + 1] = "";
+  int ok = 0, fail = 0;
+  for (;;) {
+    int q = bkNext(b, end, pos, r);
+    if (q < 0) { if (open) { nvs_commit(h); nvs_close(h); } return -1; }
+    if (q == 0) break;
+    if (bkNsSkip(r.ns)) continue;                                  // jaga-jaga: file dari luar
+    if (!open || strcmp(curNs, r.ns) != 0) {
+      if (open) { nvs_commit(h); nvs_close(h); }
+      open = nvs_open(r.ns, NVS_READWRITE, &h) == ESP_OK;
+      strncpy(curNs, r.ns, BK_NAME_MAX); curNs[BK_NAME_MAX] = 0;
+    }
+    if (!open) { fail++; continue; }
+    esp_err_t e = ESP_FAIL;
+    switch (r.type) {
+      case BK_T_U8:  e = nvs_set_u8(h, r.key, r.data[0]); break;
+      case BK_T_I8:  e = nvs_set_i8(h, r.key, (int8_t)r.data[0]); break;
+      case BK_T_U16: { uint16_t v; memcpy(&v, r.data, 2); e = nvs_set_u16(h, r.key, v); } break;
+      case BK_T_I16: { int16_t  v; memcpy(&v, r.data, 2); e = nvs_set_i16(h, r.key, v); } break;
+      case BK_T_U32: { uint32_t v; memcpy(&v, r.data, 4); e = nvs_set_u32(h, r.key, v); } break;
+      case BK_T_I32: { int32_t  v; memcpy(&v, r.data, 4); e = nvs_set_i32(h, r.key, v); } break;
+      case BK_T_U64: { uint64_t v; memcpy(&v, r.data, 8); e = nvs_set_u64(h, r.key, v); } break;
+      case BK_T_I64: { int64_t  v; memcpy(&v, r.data, 8); e = nvs_set_i64(h, r.key, v); } break;
+      case BK_T_STR: e = nvs_set_str(h, r.key, (const char*)r.data); break;
+      case BK_T_BLOB: e = nvs_set_blob(h, r.key, r.data, r.len); break;
+    }
+    if (e == ESP_OK) ok++; else fail++;
+  }
+  if (open) { nvs_commit(h); nvs_close(h); }
+  if (outFail) *outFail = fail;
+  return ok;
+}
+
+// ---------------------------------------------------------------------
+// daftar file di SD
+// ---------------------------------------------------------------------
+static void bkScan(bool prune) {
+  bkListN = 0;
+  if (!sdReady) return;
+  File d = SD_MMC.open(BK_DIR);
+  if (!d) return;
+  if (!d.isDirectory()) { d.close(); return; }
+  int nums[100]; int n = 0;
+  for (File e = d.openNextFile(); e; e = d.openNextFile()) {
+    if (!e.isDirectory()) { int k = bkParseName(e.name()); if (k >= 0 && n < 100) nums[n++] = k; }
+    e.close();
+  }
+  d.close();
+  for (int i = 1; i < n; i++) { int v = nums[i], j = i - 1; while (j >= 0 && nums[j] < v) { nums[j + 1] = nums[j]; j--; } nums[j + 1] = v; }   // terbaru dulu
+  if (prune) {
+    for (int i = BK_KEEP; i < n; i++) { char p[40]; bkMakeName(p, sizeof(p), nums[i]); SD_MMC.remove(p); }
+  }
+  for (int i = 0; i < n && i < BK_KEEP; i++) {
+    char p[40]; bkMakeName(p, sizeof(p), nums[i]);
+    bkNum[i] = nums[i]; bkValid[i] = false; bkSize[i] = 0; bkEpoch[i] = 0; bkCnt[i] = 0; bkFlg[i] = 0;
+    File f = SD_MMC.open(p, FILE_READ);
+    if (f) {
+      bkSize[i] = (uint32_t)f.size();
+      uint8_t hb[BK_HDR];
+      if (f.read(hb, BK_HDR) == BK_HDR) {
+        BkHdr h;
+        if (bkParseHdr(hb, BK_HDR, h)) { bkValid[i] = true; bkEpoch[i] = h.epoch; bkCnt[i] = h.count; bkFlg[i] = h.flags; }
+      }
+      f.close();
+    }
+    bkListN++;
+  }
+}
+
+static void bkClampScroll() {
+  int listH = bkR[BKR_LIST][3];
+  float mx = (float)(bkListN * BK_ROW_H - listH);
+  if (mx < 0) mx = 0;
+  if (bkScroll > mx) bkScroll = mx;
+  if (bkScroll < 0) bkScroll = 0;
+}
+
+// ---------------------------------------------------------------------
+// aksi
+// ---------------------------------------------------------------------
+static void bkDoCreate() {
+  if (!sdReady) { bkSay("SD Card tidak terdeteksi", 2200); return; }
+  uint8_t* buf = bkAlloc(BK_BUF_MAX);
+  if (!buf) { bkSay("PSRAM tidak cukup", 2200); return; }
+  size_t len = 0; int cnt = 0;
+  int rc = bkCollect(buf, BK_BUF_MAX, bkSecrets, &len, &cnt);
+  if (rc == 1) { free(buf); bkSay("Pengaturan terlalu besar", 2400); return; }
+  if (rc != 0) { free(buf); bkSay("Gagal membaca pengaturan", 2400); return; }
+  if (!SD_MMC.exists(BK_DIR)) SD_MMC.mkdir(BK_DIR);
+  bkScan(false);
+  int next = bkListN ? bkNum[0] + 1 : 1;
+  char path[40]; bkMakeName(path, sizeof(path), next);
+  File f = SD_MMC.open(path, FILE_WRITE);
+  bool ok = false;
+  if (f) { ok = (f.write(buf, len) == len); f.close(); }
+  if (ok) {                                                       // baca ulang & cek CRC supaya yakin utuh
+    File g = SD_MMC.open(path, FILE_READ);
+    ok = false;
+    if (g && (size_t)g.size() == len) {
+      uint8_t* chk = bkAlloc(len);
+      if (chk) { ok = (g.read(chk, len) == len); BkHdr h; ok = ok && bkVerify(chk, len, h); free(chk); }
+    }
+    if (g) g.close();
+  }
+  free(buf);
+  if (!ok) { SD_MMC.remove(path); bkSay("Gagal menulis ke SD", 2400); return; }
+  bkScan(true);
+  bkSel = 0; bkScroll = 0; bkArmKind = 0;
+  char m[44]; snprintf(m, sizeof(m), "Backup #%03d dibuat (%d nilai)", next, cnt);
+  bkSay(m, 2400);
+}
+
+static void bkDoRestore(int idx) {
+  char path[40]; bkMakeName(path, sizeof(path), bkNum[idx]);
+  File f = SD_MMC.open(path, FILE_READ);
+  if (!f) { bkSay("File tidak bisa dibuka", 2200); return; }
+  size_t n = (size_t)f.size();
+  if (n < BK_HDR + 5 || n > BK_BUF_MAX) { f.close(); bkSay("Ukuran file tidak wajar", 2200); return; }
+  uint8_t* buf = bkAlloc(n);
+  if (!buf) { f.close(); bkSay("PSRAM tidak cukup", 2200); return; }
+  size_t got = f.read(buf, n); f.close();
+  if (got != n) { free(buf); bkSay("File terbaca tidak utuh", 2200); return; }
+  int fail = 0;
+  int ok = bkApply(buf, n, &fail);
+  free(buf);
+  if (ok < 0) { bkSay("Backup rusak, ditolak", 2600); return; }
+  char m[44];
+  if (fail) snprintf(m, sizeof(m), "Dipulihkan %d, gagal %d. Restart...", ok, fail);
+  else      snprintf(m, sizeof(m), "Dipulihkan %d nilai. Restart...", ok);
+  bkSay(m, 2600);
+  bkRestartAt = millis() + 2200;                                   // drawBackup() melakukan restart
+}
+
+static void bkDoDelete(int idx) {
+  char path[40]; bkMakeName(path, sizeof(path), bkNum[idx]);
+  int num = bkNum[idx];
+  bool ok = SD_MMC.remove(path);
+  bkSel = -1; bkArmKind = 0;
+  bkScan(false); bkClampScroll();
+  char m[44]; snprintf(m, sizeof(m), ok ? "Backup #%03d dihapus" : "Gagal menghapus #%03d", num);
+  bkSay(m, 1800);
+}
